    "value": {
      "enabled": true,
      "title": "core-banking-ledger: slow-call rate above 50%",
      "description": "The core banking ledger (mainframe system of record) is slow: more than half of recent calls exceeded the 1.5 s slow-call threshold in 3 of the last 5 minutes. This is the condition that opens its circuit breaker.",
      "source": "payment-orchestration-service circuit breaker demo",
      "executionSettings": {},
      "analyzer": {
        "name": "dt.statistics.ui.anomaly_detection.StaticThresholdAnomalyDetectionAnalyzer",
        "input": [
          {
            "key": "query",
            "value": "timeseries slowCallRate = avg(resilience4j.circuitbreaker.slow.call.rate), by:{datacenter}, interval:1m, filter:name == \"core-banking-ledger\""
          },
          {
            "key": "threshold",
            "value": "50"
          },
          {
            "key": "alertCondition",
            "value": "ABOVE"
          },
          {
            "key": "alertOnMissingData",
            "value": "false"
          },
          {
            "key": "violatingSamples",
            "value": "3"
          },
          {
            "key": "slidingWindow",
            "value": "5"
          },
          {
            "key": "dealertingSamples",
            "value": "5"
          }
        ]
      },
      "eventTemplate": {
        "properties": [
          {
            "key": "event.type",
            "value": "PERFORMANCE_EVENT"
          },
          {
            "key": "event.name",
            "value": "Core banking ledger slow ({dims:datacenter})"
          },
          {
            "key": "event.description",
            "value": "Slow-call rate on the core-banking-ledger circuit breaker is above 50%. Balance inquiries are served from a stale cache and postings are queued as PENDING while the breaker is open."
          },
          {
            "key": "circuit_breaker",
            "value": "core-banking-ledger"
          },
          {
            "key": "criticality",
            "value": "critical"
          },
          {
            "key": "fallback",
            "value": "stale cached balance; postings queued as PENDING"
          },
          {
            "key": "service",
            "value": "payment-orchestration-service"
          }
        ]
      }
    }
  },
